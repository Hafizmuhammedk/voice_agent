# LiveKit Cloud project credentials. Keep real values only in .env.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-project-api-key
LIVEKIT_API_SECRET=your-project-api-secret
LIVEKIT_AGENT_NAME=general-assistant

# Direct Gemini LLM authentication. GEMINI_API_KEY is also accepted as a fallback.
GOOGLE_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# FastAPI persistence and runtime lifecycle callback.
DATABASE_URL=sqlite+aiosqlite:///./voice_agent.db
BACKEND_API_URL=http://127.0.0.1:8000
BACKEND_API_TOKEN=replace-with-a-long-random-internal-token
VOICE_PROVIDER=livekit-inference
VOICE_MODEL=cartesia/sonic-3

# General assistant persona.
VOICE_AGENT_NAME=Alex
COMPANY_NAME=your hotel
AGENT_LANGUAGE=en-US
AGENT_TIMEZONE=Asia/Kolkata
AGENT_INSTRUCTIONS=Help hotel guests with reservations, rooms, amenities, policies, directions, and service requests.
LLM_TEMPERATURE=0.3
AGENT_PERSONALITY=friendly
SPEAKING_SPEED=1.0

# Cartesia voice used through LiveKit Inference.
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02

# Optional behavior.
ENABLE_BACKGROUND_AUDIO=true
AEC_WARMUP_SECONDS=0.5
NOISE_SUPPRESSION_LEVEL=0.7

# Optional SIP calling and transfer.
# Keep Twilio credentials in backend/.env only; never commit real values.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-a-rotated-auth-token
TWILIO_PHONE_NUMBER=+15105550123
TWILIO_TRIAL_MODE=true
SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxx
# HUMAN_TRANSFER_NUMBER=+15105550123
